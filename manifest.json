{
    "manifest_version": 3,
    "name": "还我推流权",
    "version": "1.1.0",
    "description": "B 站网页开播兼容修复，支持新版推流地址与开播接口。实际可用性取决于服务端响应。",
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://api.live.bilibili.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://link.bilibili.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "还我推流权"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
